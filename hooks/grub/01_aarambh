#!/bin/sh
#
# GRUB snippet: refresh the kernel list, then apply the kernel picked in Aarambh.

. /etc/aarambh.env

# Standard output becomes grub.cfg, so only warnings and errors are let through.
/usr/local/sbin/aarambh-kernels >/dev/null || true

cat <<CFG
search --no-floppy --file --set=aarambh_esp /EFI/aarambh/next-$KEY.cfg
if [ -n "\$aarambh_esp" ]; then
  source (\$aarambh_esp)/EFI/aarambh/next-$KEY.cfg
fi
CFG
