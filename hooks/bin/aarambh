#!/bin/bash
#
# Change Aarambh settings from the command line. Edits aarambh.conf on the
# shared EFI partition, so a change made from any connected OS applies to
# every boot.
#
# Usage: aarambh [options]
#
#   -t, --theme <name>       Set the theme, e.g. cinema
#   -d, --default <os>       Set the default entry: OS id (ubuntu, fedora,
#                            windows), menu title or index
#   -T, --timeout <seconds>  Set the countdown (0 to 999), 0 disables it
#       --themes             List the themes
#   -l, --list               List the menu entries
#   -s, --status             Show the current theme, default and timeout
#   -h, --help               Show this help

set -uo pipefail

LIB_DIR="${AARAMBH_LIB_DIR:-/usr/local/lib/aarambh}"
TIMEOUT_MAX=999
THEMES="accordion minimal glass-sidebar editorial editorial-dark cinema honeycomb constellation picker-wheel dial hud departures gallery"
ACTIONS=()

usage() {
    sed -n '3,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

needs_value() {
    if [ -z "${2:-}" ]; then
        echo "aarambh: error: $1 needs a value" >&2
        usage 1
    fi
}

parse_arguments() {
    if [ "$#" -eq 0 ]; then
        ACTIONS+=("status")
    fi

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -t|--theme)
                needs_value "$1" "${2:-}"
                ACTIONS+=("theme:$2")
                shift
                ;;
            -d|--default)
                needs_value "$1" "${2:-}"
                ACTIONS+=("default:$2")
                shift
                ;;
            -T|--timeout)
                needs_value "$1" "${2:-}"
                ACTIONS+=("timeout:$2")
                shift
                ;;
            --themes) ACTIONS+=("themes") ;;
            -l|--list) ACTIONS+=("list") ;;
            -s|--status) ACTIONS+=("status") ;;
            -h|--help) usage 0 ;;
            *)
                echo "aarambh: error: unknown option $1" >&2
                usage 1
                ;;
        esac
        shift
    done
}

parse_arguments "$@"

if [ "$(id -u)" != 0 ] && [ -z "${AARAMBH_ROOT:-}" ]; then
    exec sudo bash "${BASH_SOURCE[0]}" "$@"
fi

# shellcheck source=../lib/common.sh
. "$LIB_DIR/common.sh"

if ! load_environment; then
    die "$ENV_FILE not found. Run hooks/setup.sh on this OS first."
fi

CONFIG_FILE="$ESP_DIR/aarambh.conf"

if [ ! -f "$CONFIG_FILE" ]; then
    die "$CONFIG_FILE not found. Is the EFI partition mounted?"
fi

config_value() {
    awk -v key="$1" '$1 == key { sub(/^[^ \t]+[ \t]*/, ""); value = $0 } END { print value }' "$CONFIG_FILE"
}

write_config_value() {
    CONFIG_KEY="$1" CONFIG_VALUE="$2" awk '
        BEGIN {
            key = ENVIRON["CONFIG_KEY"]
            line = key " " ENVIRON["CONFIG_VALUE"]
        }
        $1 == key {
            if (!done) {
                print line
                done = 1
            }
            next
        }
        /^entry[ \t]/ && !done {
            print line
            print ""
            done = 1
        }
        { print }
        END {
            if (!done) {
                print line
            }
        }
    ' "$CONFIG_FILE" | replace_file "$CONFIG_FILE"
}

# Read, change and replace under the lock every writer of aarambh.conf takes,
# so a change made at the same time by another command is not lost.
set_config_value() {
    with_config_lock write_config_value "$1" "$2" \
        || die "could not update $CONFIG_FILE (is the EFI partition full or read-only?)"
    sync
}

lowercase() {
    printf '%s' "$1" | tr 'A-Z' 'a-z'
}

# The loaders aarambh.efi looks for in a folder under \EFI\ (autodetect.c),
# in the same order.
LOADER_CANDIDATES='shimx64.efi shim.efi grubx64.efi systemd-bootx64.efi refind_x64.efi Boot\bootmgfw.efi'

# The file an ESP path (\EFI\ubuntu\shimx64.efi) names, matched without regard
# to case as the firmware does. Fails when it does not exist.
esp_file() {
    local current=$ESP_ROOT
    local parts
    local part
    local match

    # shellcheck disable=SC1003,SC2141
    IFS='\' read -r -a parts <<< "${1#\\}"

    for part in "${parts[@]}"; do
        if [ -z "$part" ]; then
            continue
        fi

        match=$(find "$current" -mindepth 1 -maxdepth 1 -iname "$part" -print -quit 2>/dev/null)
        if [ -z "$match" ]; then
            return 1
        fi
        current=$match
    done

    [ -f "$current" ]
}

# "key|title|loader" for each entry line of aarambh.conf, in file order.
config_entry_lines() {
    awk -F'|' '/^entry[ \t]/ {
        title = $1
        loader = $2
        key = $5
        sub(/^entry[ \t]+/, "", title)
        gsub(/^[ \t]+|[ \t]+$/, "", title)
        gsub(/^[ \t]+|[ \t]+$/, "", loader)
        gsub(/^[ \t]+|[ \t]+$/, "", key)
        print key "|" title "|" loader
    }' "$CONFIG_FILE"
}

# "key|title" of the configured operating systems that are in the menu: those
# whose loader exists. aarambh.efi skips the others.
configured_entries() {
    local key
    local title
    local loader

    while IFS='|' read -r key title loader; do
        case "$loader" in
            @*|'') ;;
            *)
                if esp_file "$loader"; then
                    echo "$key|$title"
                fi
                ;;
        esac
    done < <(config_entry_lines)
}

# The folder under \EFI\ a loader path is in, lowercase.
loader_folder() {
    local path=${1#\\}

    path=${path#[Ee][Ff][Ii]\\}
    lowercase "${path%%\\*}"
}

configured_folders() {
    local key
    local title
    local loader

    while IFS='|' read -r key title loader; do
        case "$loader" in
            @*|'') ;;
            *)
                if esp_file "$loader"; then
                    loader_folder "$loader"
                    echo
                fi
                ;;
        esac
    done < <(config_entry_lines)
}

first_loader() {
    local folder=$1
    local candidate

    for candidate in $LOADER_CANDIDATES; do
        if esp_file "\\EFI\\$folder\\$candidate"; then
            printf '%s\n' "\\EFI\\$folder\\$candidate"
            return 0
        fi
    done

    return 1
}

# "key|folder" of the systems aarambh.efi adds by itself: the same folders,
# skip rules and loader files as autodetect.c, and nothing with autodetect
# turned off.
detected_entries() {
    local directory
    local folder
    local name
    local key
    local used

    if grep -q '^autodetect\([ \t]\|$\)' "$CONFIG_FILE" && [ "$(config_value autodetect)" != yes ]; then
        return 0
    fi

    used=$(configured_folders)

    for directory in "$ESP_ROOT"/[Ee][Ff][Ii]/*/; do
        if [ ! -d "$directory" ]; then
            continue
        fi

        folder=$(basename "$directory")
        name=$(lowercase "$folder")

        case "$name" in
            boot|aarambh|linux|tools) continue ;;
            microsoft) key=windows ;;
            redhat) key=rhel ;;
            systemd) key=systemd-boot ;;
            grub) key=linux ;;
            *) key=$name ;;
        esac

        if grep -qxF "$name" <<< "$used" || ! first_loader "$folder" >/dev/null; then
            continue
        fi

        echo "$key|$folder"
    done
}

# Every operating system in the menu, in the order aarambh.efi shows them.
menu_systems() {
    configured_entries
    detected_entries
}

is_action_name() {
    case "$(lowercase "$1")" in
        firmware|restart|reboot|"power off"|poweroff|shutdown) return 0 ;;
    esac
    return 1
}

# Prints the key or index to store, or fails with the reason on stderr.
resolve_default() {
    local wanted
    local index
    local count
    local key
    local title

    wanted=$(lowercase "$1")

    case "$1" in
        ''|*[!0-9]*) ;;
        *)
            index=$(printf '%s' "$1" | sed 's/^0*//')
            index=${index:-0}
            count=$(menu_systems | grep -c .)

            if [ "${#index}" -gt 2 ] || [ "$index" -ge "$count" ]; then
                echo "aarambh: error: there is no operating system number $1 (the menu has $count, counted from 0)" >&2
                return 1
            fi
            echo "$index"
            return 0
            ;;
    esac

    while IFS='|' read -r key title; do
        if [ -n "$key" ] && { [ "$(lowercase "$key")" = "$wanted" ] || [ "$(lowercase "$title")" = "$wanted" ]; }; then
            echo "$key"
            return 0
        fi
    done < <(menu_systems)

    if is_action_name "$1"; then
        echo "aarambh: error: '$1' cannot be the default, only an operating system starts by itself" >&2
    else
        echo "aarambh: error: no operating system called '$1' is in the menu" >&2
    fi
    return 1
}

show_themes() {
    local current
    local theme

    current=$(config_value theme)

    for theme in $THEMES; do
        if [ "$theme" = "${current:-accordion}" ]; then
            echo "* $theme"
        else
            echo "  $theme"
        fi
    done
}

show_entries() {
    local default
    local key
    local title
    local loader

    default=$(lowercase "$(config_value default)")

    while IFS='|' read -r key title loader; do
        local mark=" "

        if [ -n "$key" ] && [ "$(lowercase "$key")" = "$default" ]; then
            mark="*"
        fi

        case "$loader" in
            @*|'') printf '%s %-14s %s\n' "$mark" "${key:--}" "$title" ;;
            *)
                if esp_file "$loader"; then
                    printf '%s %-14s %s\n' "$mark" "${key:--}" "$title"
                else
                    printf '%s %-14s %s (not in the menu: %s is missing)\n' "$mark" "${key:--}" "$title" "$loader"
                fi
                ;;
        esac
    done < <(config_entry_lines)

    while IFS='|' read -r key folder; do
        local mark=" "

        if [ "$(lowercase "$key")" = "$default" ]; then
            mark="*"
        fi

        printf '%s %-14s found at boot in \\EFI\\%s\n' "$mark" "$key" "$folder"
    done < <(detected_entries)
}

show_status() {
    echo "config:  $CONFIG_FILE"
    echo "theme:   $(config_value theme)"
    echo "default: $(config_value default)"
    echo "timeout: $(config_value timeout)"
}

apply_theme() {
    if [[ " $THEMES " != *" $1 "* ]]; then
        echo "aarambh: error: unknown theme '$1'. Available themes:" >&2
        show_themes >&2
        exit 1
    fi

    set_config_value theme "$1"
    log "theme set to $1"
}

apply_default() {
    local key

    if ! key=$(resolve_default "$1"); then
        echo "Entries:" >&2
        show_entries >&2
        exit 1
    fi

    set_config_value default "$key"
    log "default set to $key"
}

apply_timeout() {
    local seconds

    case "$1" in
        ''|*[!0-9]*) die "timeout must be a whole number of seconds, 0 to $TIMEOUT_MAX" ;;
    esac

    seconds=$(printf '%s' "$1" | sed 's/^0*//')
    seconds=${seconds:-0}

    if [ "${#seconds}" -gt "${#TIMEOUT_MAX}" ] || [ "$seconds" -gt "$TIMEOUT_MAX" ]; then
        die "timeout must be 0 to $TIMEOUT_MAX seconds"
    fi

    set_config_value timeout "$seconds"
    log "timeout set to $seconds seconds"
}

for action in "${ACTIONS[@]}"; do
    case "$action" in
        theme:*) apply_theme "${action#theme:}" ;;
        default:*) apply_default "${action#default:}" ;;
        timeout:*) apply_timeout "${action#timeout:}" ;;
        themes) show_themes ;;
        list) show_entries ;;
        status) show_status ;;
    esac
done
